<?xml version="1.0" encoding="utf-8"?>
<zt-menu>
    <!--####################### 说明 ########################
    文件路径:
    /data/data/com.termux/files/home/ZtInfo/main_menu_path.xml
    此文件是VictorSuite左侧菜单栏的配置文件，可随意修改（注意格式,错误左侧栏可能无法正常显示）
    如果需要恢复默认请使用：
    zt menu reset 命令来复原
    如果修改完成立即刷新请使用
    zt menu update 命令或重启APP来立即生效
    ########################### 说明 ########################-->


    <!--示例:
    分组名称:
    <group id="0" name="常用功能">
        ####################### name ########################
        1.name: 点击事件的名称
        示例：name="切换源"
        ####################### click ########################
        1.click: 调用VictorSuite内部的 JAVA 类
        示例: click="java:com.termux.victor.config.mainmenu.config.SwitchSourceClickConfig"
        2.或跳转到网址页
        click="jumpUrl:www.example.com"
        3.或执行shell语句
        click="ztShell:cd ~ && pkg update"
        4.如果需要直接执行,请修改此配置项
        autoRunShell="true"
        ####################### icon ########################
        注意，此属性只有在 click 非java: 开头才有效果
        1.icon: 图标 application 开头的是调用VictorSuite内部的资源, 或者填写绝对路径
        示例:(
        绝对路径: icon="imgPath:/data/data/com.termux/files/home/ZTinfo/1.png")
        ####################### shell ########################
    </group>-->

    <!--此处只是示例，根据自己以后编辑，如果正常使用可注释掉此菜单
    然后使用
    zt menu update 立即刷新-->
    <!--#######################可删除#########################-->
    <group enabled="false" name="示例点击事件(可在配置文件删除此分组)">
        <item tag="自定义左侧栏"
            name="编辑菜单"
            icon="imgPath:/data/data/com.termux/files/home/ZtInfo/edit_menu.png"
            click="ztEditText:/data/data/com.termux/files/home/ZtInfo/main_menu_path.xml" />
        <!--dialog 属性只能对于 click 为 ztShell 生效
        dialogConfirm 为 false 则不提示
        -->
        <item tag="执行终端命令"
            name="执行终端"
            icon=""
            dialogConfirm="true"
            dialogTitle="温馨提示"
            dialogMessage="要执行此段shell语句吗"
            autoRunShell="false"
            click="ztShell:cd ~ &amp;&amp; pkg update" />
        <item tag="跳转网址"
            name="跳转网址"
            icon=""
            click="jumpUrl:https://www.example.com" />
        <item tag="占位,什么都不做"
            name="占位菜单"
            icon=""
            click="" />
        <item tag="跳转内部活动"
            name="跳转设置"
            icon=""
            packageName="com.termux"
            intentData=""
            click="startActivity:com.termux.victor.settings.VsSettingsActivity" />
        <!--intentData 属性值，目前只支持 String 字符串
            key@@value-->
        <item tag="跳转action"
            name="跳转Action"
            icon=""
            intentData="data@@com.termux"
            packageName="com.android.settings"
            click="actionActivity:android.settings.WIRELESS_SETTINGS" />
        <!--List列表
        名称@@命令,名称@@命令,名称@@命令
        && 在XML转换为 &amp;&amp;
        -->
        <item tag="List列表"
            name="List列表"
            autoRunShell="true"
            listTitle="请选择一个命令"
            click="commands:单行命令@@pkg update,多行命令@@pkg update &amp;&amp; pkg install vim,安装git@@pkg install git" />

        <item tag="在线脚本"
            name="在线脚本"
            icon=""
            click="shellUrl:https://raw.githubusercontent.com/Victorious93/VictorSuite/main/remote/on_line_sh/main.json" />

        <item tag="下载站"
            name="下载站"
            icon=""
            click="downloadUrl:https://raw.githubusercontent.com/Victorious93/VictorSuite/main/remote/repository/main.json" />

        <item tag="应用内打开URL"
            name="应用内URL"
            icon=""
            activityTitle="百度一下"
            click="appWebUrl:https://www.example.com" />

    </group>
    <!--#######################可删除#########################-->

    <!--不要尝试修改TAG标签，此标签是备注标签！对于click属性java: 开头的无法修改icon,可自由替换组和排序-->
    <!--不要尝试修改TAG标签，此标签是备注标签！对于click属性java: 开头的无法修改icon,可自由替换组和排序-->
