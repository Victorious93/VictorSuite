<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="match_parent"
    tools:context=".victor.developer.DeveloperActivity">

    <com.billy.android.swipe.SmartSwipeWrapper
        android:layout_width="match_parent"
        android:id="@+id/smart_swipe"
        android:layout_height="match_parent">

        <LinearLayout
            app:swipe_gravity="right|left"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <Button
                android:id="@+id/star_button"
                android:layout_width="wrap_content"
                android:layout_height="match_parent" android:background="#15BABA"/>
            <Button
                android:id="@+id/like_button"
                android:layout_width="wrap_content"
                android:layout_height="match_parent" android:background="@color/vs_neon_surface"/>
        </LinearLayout>




    </com.billy.android.swipe.SmartSwipeWrapper>

    <TextView
        android:layout_width="match_parent"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:textColor="@color/color_ffffff"
        android:textSize="16sp"
        android:text="This page may cause data loss"
        android:layout_height="wrap_content"/>
    <Button
        android:layout_width="wrap_content"
        style="@style/Theme.Termux.Black"
        android:layout_marginTop="10dp"
        android:text="Create files symlink"
        android:id="@+id/create_files"
        android:layout_height="wrap_content"/>
    <Button
        android:layout_width="wrap_content"
        style="@style/Theme.Termux.Black"
        android:text="Start samba service"
        android:id="@+id/samba_create"
        android:layout_height="wrap_content"/>
    <Button
        android:layout_width="wrap_content"
        style="@style/Theme.Termux.Black"
        android:text="Test 1"
        android:id="@+id/test1"
        android:layout_height="wrap_content"/>
    <Button
        android:layout_width="wrap_content"
        style="@style/Theme.Termux.Black"
        android:text="Test zip compression"
        android:id="@+id/test_zip"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/test_unzip"
        android:layout_width="wrap_content"
        android:text="Test zip extraction..."
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/test_rlj"
        android:layout_width="wrap_content"
        android:text="Test symlink..."
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/adb_connect"
        android:layout_width="wrap_content"
        android:text="ADB connection dialog"
        android:layout_height="wrap_content"/>

</LinearLayout>
