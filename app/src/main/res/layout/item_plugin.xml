<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:padding="6dp"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_marginRight="10dp"
                android:layout_toLeftOf="@+id/switch_btn"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:text="@string/vs_title"
                    android:textStyle="bold"
                    android:id="@+id/name"
                    android:textSize="14sp"
                    android:textColor="@color/color_ffffff"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_marginTop="3dp"
                    android:id="@+id/version_category"
                    android:textSize="10sp"
                    android:textColor="@color/color_55ffffff"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/color_ffffff"
                    android:textSize="10sp"/>

                <TextView
                    android:id="@+id/state_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/color_48baf3"
                    android:textSize="10sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/configure_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/plugin_configure"
                        android:textColor="@color/color_48baf3"
                        android:textSize="11sp"
                        android:padding="4dp"/>

                    <TextView
                        android:id="@+id/launch_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="14dp"
                        android:text="@string/plugin_launch"
                        android:textColor="@color/color_48baf3"
                        android:textSize="11sp"
                        android:padding="4dp"/>

                </LinearLayout>

            </LinearLayout>

            <com.github.iielse.switchbutton.SwitchView
                android:layout_width="35dp"
                android:id="@+id/switch_btn"
                android:layout_alignParentRight="true"
                android:layout_height="wrap_content"/>

        </RelativeLayout>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_marginTop="6dp"
        android:background="@color/color_55ffffff"
        android:layout_height="1px"/>

</LinearLayout>
