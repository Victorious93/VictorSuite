<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vs_neon_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/vs_neon_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/my_pc_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="@string/my_pc_title"
            android:textColor="@color/vs_neon_cyan"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            style="@style/MyPcBody"
            android:text="@string/my_pc_subtitle"
            android:textColor="@color/vs_neon_muted" />

        <TextView
            style="@style/MyPcBody"
            android:paddingBottom="12dp"
            android:text="@string/my_pc_direction_note"
            android:textColor="@color/vs_neon_muted" />

        <LinearLayout
            android:id="@+id/my_pc_warning_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_my_pc_warning"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="6dp"
                android:text="@string/my_pc_warning_title"
                android:textColor="@color/vs_neon_magenta"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/my_pc_warning_body"
                style="@style/MyPcBody"
                android:text="@string/my_pc_warning_body" />

            <TextView
                android:id="@+id/my_pc_gate_status"
                style="@style/MyPcBody"
                android:textColor="@color/vs_neon_muted" />

            <Button
                android:id="@+id/my_pc_ack_button"
                style="@style/MyPcButton"
                android:text="@string/my_pc_ack_button" />

            <Button
                android:id="@+id/my_pc_relock_button"
                style="@style/MyPcButton"
                android:text="@string/my_pc_relock_button" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_my_pc_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/MyPcSectionTitle"
                android:text="@string/my_pc_status_section" />

            <TextView
                android:id="@+id/my_pc_status_wireless"
                style="@style/MyPcBody" />

            <TextView
                android:id="@+id/my_pc_status_usb"
                style="@style/MyPcBody" />

            <TextView
                android:id="@+id/my_pc_status_legacy"
                style="@style/MyPcBody" />

            <TextView
                style="@style/MyPcSectionTitle"
                android:paddingTop="8dp"
                android:text="@string/my_pc_addresses_section" />

            <TextView
                android:id="@+id/my_pc_addresses"
                style="@style/MyPcBody"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_my_pc_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/MyPcSectionTitle"
                android:text="@string/my_pc_howto_section" />

            <TextView
                style="@style/MyPcBody"
                android:text="@string/my_pc_howto_wifi" />

            <TextView
                style="@style/MyPcBody"
                android:text="@string/my_pc_howto_tailscale" />

            <TextView
                style="@style/MyPcBody"
                android:text="@string/my_pc_howto_pc" />

            <Button
                android:id="@+id/my_pc_open_dev_options"
                style="@style/MyPcButton"
                android:text="@string/my_pc_open_dev_options" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_my_pc_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/MyPcSectionTitle"
                android:text="@string/my_pc_commands_section" />

            <TextView
                style="@style/MyPcBody"
                android:text="@string/my_pc_host_label"
                android:textColor="@color/vs_neon_muted" />

            <EditText
                android:id="@+id/my_pc_host_input"
                style="@style/MyPcInput"
                android:inputType="phone"
                android:digits="0123456789." />

            <TextView
                style="@style/MyPcBody"
                android:paddingTop="8dp"
                android:text="@string/my_pc_port_label"
                android:textColor="@color/vs_neon_muted" />

            <EditText
                android:id="@+id/my_pc_port_input"
                style="@style/MyPcInput"
                android:inputType="number"
                android:maxLength="5" />

            <TextView
                style="@style/MyPcBody"
                android:paddingTop="8dp"
                android:text="@string/my_pc_pairing_port_label"
                android:textColor="@color/vs_neon_muted" />

            <EditText
                android:id="@+id/my_pc_pairing_port_input"
                style="@style/MyPcInput"
                android:inputType="number"
                android:maxLength="5" />

            <Button
                android:id="@+id/my_pc_build_button"
                style="@style/MyPcButton"
                android:text="@string/my_pc_build_button" />

            <TextView
                android:id="@+id/my_pc_commands_output"
                style="@style/MyPcBody"
                android:paddingTop="10dp"
                android:fontFamily="monospace"
                android:textColor="@color/vs_neon_cyan"
                android:textIsSelectable="true" />

            <Button
                android:id="@+id/my_pc_copy_button"
                style="@style/MyPcButton"
                android:text="@string/my_pc_copy_button" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_my_pc_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/MyPcSectionTitle"
                android:text="@string/my_pc_stop_section" />

            <TextView
                style="@style/MyPcBody"
                android:text="@string/my_pc_stop_body" />

            <Button
                android:id="@+id/my_pc_stop_dev_options"
                style="@style/MyPcButton"
                android:text="@string/my_pc_open_dev_options" />
        </LinearLayout>

        <TextView
            style="@style/MyPcBody"
            android:text="@string/my_pc_credit"
            android:textColor="@color/vs_neon_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
