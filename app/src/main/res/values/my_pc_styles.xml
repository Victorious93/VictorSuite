<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MyPcSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/vs_neon_cyan</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="MyPcBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/vs_neon_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="MyPcButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_my_pc_button</item>
        <item name="android:textColor">@color/my_pc_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="MyPcInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_my_pc_input</item>
        <item name="android:textColor">@color/vs_neon_text</item>
        <item name="android:textColorHint">@color/vs_neon_muted</item>
        <item name="android:padding">10dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
